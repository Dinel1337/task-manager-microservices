# Application
APP_NAME=task-service
ENV=DEV
LOG_LEVEL=INFO
PORT=8000
ROOT_PATH=

# PostgreSQL
POSTGRES_HOST=postgres-tasks
POSTGRES_PORT=5432
POSTGRES_DB=tasks_db
POSTGRES_USER=tasks_user
POSTGRES_PASSWORD=tasks_password
POSTGRES_SCHEMA=task_service
MIN_POOL_SIZE=5
MAX_POOL_SIZE=10

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE=tasks
RABBITMQ_ROUTING_KEY=task.notification



