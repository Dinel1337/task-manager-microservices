# Application
APP_NAME=task-notification
ENV=DEV
LOG_LEVEL=INFO
PORT=8001
ROOT_PATH=

# PostgreSQL
POSTGRES_HOST=postgres-notifications
POSTGRES_PORT=5432
POSTGRES_DB=notifications_db
POSTGRES_USER=notifications_user
POSTGRES_PASSWORD=notifications_password
POSTGRES_SCHEMA=task_notification
MIN_POOL_SIZE=5
MAX_POOL_SIZE=10

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE=tasks
RABBITMQ_QUEUE=task.notifications
RABBITMQ_ROUTING_KEY=task.notification

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ARQ
ARQ_QUEUE_NAME=arq:task_notifications



